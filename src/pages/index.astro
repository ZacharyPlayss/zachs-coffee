---
import '../styles/global.css';
import Hero from '../components/Hero/Hero.astro';
import Section2 from '../components/Section2/Section2.astro';
import Section3 from '../components/Section3/Section3.astro';
import Section4 from '../components/Section4/Section4.astro';
import Section5 from '../components/Section5/Section5.astro';
import Boxes from '../components/Boxes/Boxes.astro';
import MotionPath from '../components/MotionPath/MotionPath.astro';
import Physics from '../components/Physics/Physics.astro';
import ScrollPin from '../components/ScrollPin/ScrollPin.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Zach's Coffee!</title>
	</head>
	<body>
		<Hero />
		<Section2/>
		<Section3/>
		<Section4/>
		<Section5/>
	</body>
</html>

<style is:global lang="scss">
    @use 'webcoreui/styles' as *;
    @include setup((
        fontRegular: '/fonts/Inter-Regular.woff2',
        fontBold: '/fonts/Inter-Bold.woff2'
    ));
</style>

import MilkSteamingScene from '../animated-scenes/MilkSteamingScene/MilkSteamingScene.astro';
import { Card } from 'webcoreui/astro'
---

<section class="panel-four">
    <Card element="div" className="panel-frame" bodyClassName="panel-body" id="rotated-panel-frame-1">
        <div class="panel-content">
            <CoffeeDripScene/>
        </div>
    </Card>
    <Card element="div" className="panel-frame" bodyClassName="panel-body" id="rotated-panel-frame-2">
        <div class="panel-content">
            <MilkSteamingScene/>
        </div>
    </Card>
</section>

<script>
    import "./Section4"
</script>
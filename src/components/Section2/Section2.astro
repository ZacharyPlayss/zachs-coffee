---
import "./Section2.css";
import BaristaScene from "../animated-scenes/BaristaScene/BaristaScene.astro";
import WakingUpScene from "../animated-scenes/WakingUpScene/WakingUpScene.astro";
import { Card } from 'webcoreui/astro'
---

<section class="panel-two">
    <Card element="div" className="panel-frame" bodyClassName="panel-body" id="panel-1">
        <div class="panel-content">
            <div class="speech-bubble"><p>Rough morning?</p></div>
            <WakingUpScene />
        </div>
    </Card>
    <Card element="div" className="panel-frame" bodyClassName="panel-body" id="panel-2">
        <div class="panel-content">
            <div class="speech-bubble">
                <p>I have just the thing for you!</p>
            </div>
            <BaristaScene />
        </div>
    </Card>
</section>

<script>
    import "./Section2.js";
</script>
